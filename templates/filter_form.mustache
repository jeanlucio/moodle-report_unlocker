{{!
    @template report_unlocker/filter_form

    Client-side filter controls for the Unlocker report page.

    Example context (json):
    {
        "sections": [
            {"num": 0, "name": "Geral"},
            {"num": 1, "name": "Tópico 1"}
        ],
        "conditiontypes": [
            {"type": "date", "label": "Date"},
            {"type": "group", "label": "Group"}
        ],
        "str_allsections": "All sections",
        "str_alltypes": "All types",
        "str_clearfilters": "Clear filters",
        "str_filterbysection": "Filter by section",
        "str_filterbytype": "Filter by type",
        "str_nodateconditions_filtered": "No access restrictions match the current filter.",
        "str_removeallvisible": "Remove all visible",
        "str_removeallvisibleconfirm": "Mark {count} visible restriction(s) for removal and save all changes?",
        "str_search": "Search",
        "str_searchplaceholder": "Search by activity name..."
    }
}}
<div class="report-unlocker-filters mb-4">
    <div class="d-flex flex-wrap align-items-end">
        <div class="me-3 mb-2">
            <label for="unlocker-section-filter" class="form-label d-block">
                {{str_filterbysection}}
            </label>
            <select id="unlocker-section-filter" class="form-select form-control">
                <option value="-1">{{str_allsections}}</option>
                {{#sections}}
                <option value="{{num}}">{{name}}</option>
                {{/sections}}
            </select>
        </div>
        <div class="me-3 mb-2">
            <label for="unlocker-type-filter" class="form-label d-block">
                {{str_filterbytype}}
            </label>
            <select id="unlocker-type-filter" class="form-select form-control">
                <option value="">{{str_alltypes}}</option>
                {{#conditiontypes}}
                <option value="{{type}}">{{label}}</option>
                {{/conditiontypes}}
            </select>
        </div>
        <div class="me-3 mb-2">
            <label for="unlocker-search" class="form-label d-block">
                {{str_search}}
            </label>
            <input type="text"
                   id="unlocker-search"
                   class="form-control"
                   placeholder="{{str_searchplaceholder}}">
        </div>
        <div class="mb-2">
            <button type="button" id="unlocker-clear-filters" class="btn btn-link">
                {{str_clearfilters}}
            </button>
        </div>
        <div class="mb-2 ms-auto">
            <button type="button"
                    id="unlocker-remove-all"
                    class="btn btn-outline-danger btn-sm"
                    data-title="{{str_removeallvisible}}"
                    data-confirm="{{str_removeallvisibleconfirm}}">
                {{str_removeallvisible}}
            </button>
        </div>
    </div>
    <div id="unlocker-no-results" class="alert alert-info mt-3" hidden>
        {{str_nodateconditions_filtered}}
    </div>
</div>
